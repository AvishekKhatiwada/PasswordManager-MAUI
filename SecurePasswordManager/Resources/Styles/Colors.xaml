<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryDark">#93C5FD</Color>
    <Color x:Key="Accent">#0F766E</Color>
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#111827</Color>
    <Color x:Key="Panel">#F8FAFC</Color>
    <Color x:Key="PanelDark">#1F2937</Color>
    <Color x:Key="Text">#111827</Color>
    <Color x:Key="TextDark">#F9FAFB</Color>
    <Color x:Key="Muted">#64748B</Color>
    <Color x:Key="MutedDark">#CBD5E1</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderColorDark">#334155</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
</ResourceDictionary>
