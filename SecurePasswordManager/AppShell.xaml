<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SecurePasswordManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SecurePasswordManager.Views"
    FlyoutBehavior="Disabled"
    Title="Secure Password Manager">

    <ShellContent
        Route="OnboardingPage"
        ContentTemplate="{DataTemplate views:OnboardingPage}" />

    <ShellContent
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar Route="VaultTabs">
        <ShellContent
            Title="Vault"
            Route="DashboardPage"
            ContentTemplate="{DataTemplate views:DashboardPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#128274;" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Generator"
            Route="PasswordGeneratorPage"
            ContentTemplate="{DataTemplate views:PasswordGeneratorPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#128273;" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Notes"
            Route="SecureNotesPage"
            ContentTemplate="{DataTemplate views:SecureNotesPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#128221;" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent
            Title="Settings"
            Route="SettingsPage"
            ContentTemplate="{DataTemplate views:SettingsPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#9881;" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
