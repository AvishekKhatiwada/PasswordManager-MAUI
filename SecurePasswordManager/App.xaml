<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SecurePasswordManager"
             xmlns:utilities="clr-namespace:SecurePasswordManager.Utilities"
             x:Class="SecurePasswordManager.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utilities:InverseBoolConverter x:Key="InverseBoolConverter" />
            <utilities:BoolToItemsLayoutConverter x:Key="BoolToItemsLayoutConverter" />
            <utilities:SecureNoteDisplayConverter x:Key="SecureNoteDisplayConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
