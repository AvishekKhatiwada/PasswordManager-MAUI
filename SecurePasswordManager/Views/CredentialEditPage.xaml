<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecurePasswordManager.Views.CredentialEditPage"
             Title="Credential"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Credential" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource PanelStyle}">
                <VerticalStackLayout Spacing="12">
                    <Entry Placeholder="Title" Text="{Binding TitleText}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" ItemDisplayBinding="{Binding Name}" />
                        <Picker Grid.Column="1" ItemsSource="{Binding EntryKinds}" SelectedItem="{Binding SelectedKind}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Placeholder="New custom category" Text="{Binding NewCategoryName}" />
                        <Button Grid.Column="1" Text="Create" Command="{Binding CreateCategoryCommand}" Style="{StaticResource SmallButtonStyle}" />
                    </Grid>
                    <Entry Placeholder="Website/App" Text="{Binding Website}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Placeholder="Username" Text="{Binding Username}" />
                        <Button Grid.Column="1" Text="Copy" Command="{Binding CopyUsernameCommand}" Style="{StaticResource SmallButtonStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />
                        <Button Grid.Column="1" Text="Copy" Command="{Binding CopyEmailCommand}" Style="{StaticResource SmallButtonStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Entry Placeholder="Password"
                               IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                               Text="{Binding Password}" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsPasswordVisible}" />
                        <Button Grid.Column="2" Text="Gen" Command="{Binding GeneratePasswordCommand}" Style="{StaticResource SmallButtonStyle}" />
                    </Grid>
                    <Entry Placeholder="URL" Keyboard="Url" Text="{Binding Url}" />
                    <Entry Placeholder="Tags, comma separated" Text="{Binding Tags}" />
                    <Editor Placeholder="Notes" Text="{Binding Notes}" AutoSize="TextChanges" MinimumHeightRequest="120" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Favorite" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsFavorite}" />
                    </Grid>
                    <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Danger}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Text="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Column="1" Text="Copy" Command="{Binding CopyPasswordCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" Text="Archive" Command="{Binding ArchiveCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                    <Button Text="Move to trash" Command="{Binding DeleteCommand}" TextColor="{StaticResource Danger}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
