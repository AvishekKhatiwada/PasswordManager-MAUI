<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecurePasswordManager.Views.ChangeMasterPasswordPage"
             Title="Change master password"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <HorizontalStackLayout Spacing="12">
                <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26"
                        BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                        VerticalOptions="Start">
                    <Label Text="&#128274;" FontSize="22" Style="{StaticResource IconGlyphStyle}" TextColor="{StaticResource Primary}" />
                </Border>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Change master password" Style="{StaticResource HeroTitleStyle}" />
                    <Label Text="Re-encrypts the vault with a new key" Style="{StaticResource SubtitleStyle}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Border Style="{StaticResource PanelStyle}">
                <VerticalStackLayout Spacing="16">
                    <Entry Placeholder="Current master password"
                           IsPassword="True"
                           Text="{Binding CurrentPassword}"
                           ReturnType="Next" />
                    <Entry Placeholder="New master password"
                           IsPassword="True"
                           Text="{Binding NewPassword}"
                           ReturnType="Next" />
                    <Entry Placeholder="Confirm new master password"
                           IsPassword="True"
                           Text="{Binding ConfirmPassword}"
                           ReturnType="Done" />
                    <ProgressBar Progress="{Binding StrengthScore}" ProgressColor="{StaticResource Success}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding StrengthLabel}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding ValidationText}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="End">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasValidationError}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
                    <Button Text="Change password"
                            Command="{Binding ChangePasswordCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
