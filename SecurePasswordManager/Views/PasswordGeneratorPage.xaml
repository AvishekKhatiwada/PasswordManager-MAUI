<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecurePasswordManager.Views.PasswordGeneratorPage"
             Title="Generator"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Password generator" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource PanelStyle}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding GeneratedPassword}" FontSize="22" FontAttributes="Bold" LineBreakMode="CharacterWrap" />
                    <ProgressBar Progress="{Binding StrengthScore}" ProgressColor="{StaticResource Success}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding StrengthLabel}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding EntropyText}" Style="{StaticResource CaptionStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Length" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Length}" />
                    </Grid>
                    <Slider Minimum="8" Maximum="64" Value="{Binding Length}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Label Text="Uppercase" /><Switch Grid.Column="1" IsToggled="{Binding UseUppercase}" />
                        <Label Grid.Row="1" Text="Lowercase" /><Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding UseLowercase}" />
                        <Label Grid.Row="2" Text="Numbers" /><Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding UseNumbers}" />
                        <Label Grid.Row="3" Text="Symbols" /><Switch Grid.Row="3" Grid.Column="1" IsToggled="{Binding UseSymbols}" />
                        <Label Grid.Row="4" Text="Exclude ambiguous" /><Switch Grid.Row="4" Grid.Column="1" IsToggled="{Binding ExcludeAmbiguous}" />
                        <Label Grid.Row="5" Text="Passphrase mode" /><Switch Grid.Row="5" Grid.Column="1" IsToggled="{Binding PassphraseMode}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Passphrase words" VerticalOptions="Center" />
                        <Stepper Grid.Column="1" Minimum="3" Maximum="12" Increment="1" Value="{Binding PassphraseWords}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Generate" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Column="1" Text="Copy" Command="{Binding CopyCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
