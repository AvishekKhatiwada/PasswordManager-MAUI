<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecurePasswordManager.Views.SecureNotesPage"
             x:Name="Root"
             Title="Notes"
             Shell.NavBarIsVisible="False">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <HorizontalStackLayout Spacing="12">
                <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26"
                        BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                        VerticalOptions="Start">
                    <Label Text="&#128221;" FontSize="22" Style="{StaticResource IconGlyphStyle}" TextColor="{StaticResource Primary}" />
                </Border>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Notes" Style="{StaticResource HeroTitleStyle}" />
                    <Label Text="Your secure notes" Style="{StaticResource SubtitleStyle}" />
                    <Label Text="{Binding NoteCount, StringFormat='{0} notes'}" Style="{StaticResource CaptionStyle}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <Button Grid.Column="1"
                    Text="+  Add Note"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource PillButtonStyle}"
                    VerticalOptions="Start" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="12">
            <SearchBar Placeholder="Search notes..." Text="{Binding SearchText}" />
            <Picker Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Notes}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border Style="{StaticResource EmptyStateIconStyle}">
                        <Label Text="&#128221;" FontSize="48" Style="{StaticResource IconGlyphStyle}" />
                    </Border>
                    <Label Text="Keep your important notes safe" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" Margin="0,10,0,0" />
                    <Label Text="Store passwords, ideas, documents and more in your secure vault."
                           Style="{StaticResource SubtitleStyle}"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           WidthRequest="280" />
                    <Button Text="+  Add Note"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource PillButtonStyle}"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Start"
                                    BackgroundColor="{Binding Tags, Converter={StaticResource SecureNoteDisplayConverter}, ConverterParameter=BadgeColor}">
                                <Label Text="&#128221;"
                                       FontSize="18"
                                       Style="{StaticResource IconGlyphStyle}"
                                       TextColor="{Binding Tags, Converter={StaticResource SecureNoteDisplayConverter}, ConverterParameter=IconColor}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" />
                                <Label Text="{Binding Markdown, Converter={StaticResource SecureNoteDisplayConverter}, ConverterParameter=Snippet}"
                                       Style="{StaticResource MutedBodyStyle}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="&#128197;" FontSize="12" Style="{StaticResource IconGlyphStyle}" />
                                    <Label Text="{Binding UpdatedAt, StringFormat='Updated {0:g}'}" Style="{StaticResource CaptionStyle}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="8" HorizontalOptions="End">
                                <Border Style="{StaticResource BadgePillStyle}"
                                        BackgroundColor="{Binding Tags, Converter={StaticResource SecureNoteDisplayConverter}, ConverterParameter=BadgeColor}"
                                        IsVisible="{Binding Tags, Converter={StaticResource SecureNoteDisplayConverter}, ConverterParameter=HasTag}">
                                    <Label Text="{Binding Tags, Converter={StaticResource SecureNoteDisplayConverter}, ConverterParameter=PrimaryTag}"
                                           TextColor="{Binding Tags, Converter={StaticResource SecureNoteDisplayConverter}, ConverterParameter=BadgeTextColor}"
                                           FontSize="12"
                                           FontFamily="OpenSansSemibold" />
                                </Border>
                                <Button Text="&#8942;"
                                        Style="{StaticResource SmallButtonStyle}"
                                        WidthRequest="34"
                                        Padding="0"
                                        Clicked="OnNoteMenuClicked" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
